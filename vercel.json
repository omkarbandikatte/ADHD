{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/demo",      "dest": "/demo.html"      },
    { "src": "/(.*)",      "dest": "/$1"             }
  ]
}
